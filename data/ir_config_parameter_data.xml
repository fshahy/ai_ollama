<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="config_provider" model="ir.config_parameter">
            <field name="key">ai_ollama.provider</field>
            <field name="value">ollama</field>
        </record>
        <record id="config_endpoint" model="ir.config_parameter">
            <field name="key">ai_ollama.endpoint</field>
            <field name="value">http://host.docker.internal:11434/v1</field>
        </record>
        <record id="config_chat_model" model="ir.config_parameter">
            <field name="key">ai_ollama.chat_model</field>
            <field name="value">gemma4:e4b</field>
        </record>
        <record id="config_embedding_model" model="ir.config_parameter">
            <field name="key">ai_ollama.embedding_model</field>
            <field name="value">qwen3-embedding:0.6b</field>
        </record>
        <record id="config_context_length" model="ir.config_parameter">
            <field name="key">ai_ollama.context_length</field>
            <field name="value">16384</field>
        </record>
        <record id="config_timeout" model="ir.config_parameter">
            <field name="key">ai_ollama.timeout</field>
            <field name="value">300</field>
        </record>
    </data>
</odoo>
